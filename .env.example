# Copy this file to .env for local development (.env is gitignored).
# On Vercel, set the same variables under Project → Settings → Environment Variables.

# Postgres. Locally, e.g. the "offscreen" database on your own Postgres (the one pgAdmin shows);
# on Vercel, the Neon connection string. Leave unset to use data/db.json instead.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/offscreen

# Sign-in code emails. Gmail needs a 16-letter app password (https://myaccount.google.com/apppasswords),
# not your normal password, written without spaces. The @ in the address is written %40.
SMTP_URL=smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
MAIL_FROM=Offscreen <you@gmail.com>

# Signs the login cookie. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string
