# Copy this file to .env for local development (.env is gitignored).
# In production the pages run on Cloudflare Workers and the API on our own server; see the README
# ("Deploying") for which settings go where.

# Postgres. Locally, e.g. the "offscreen" database on your own Postgres (the one pgAdmin shows);
# on the API server, its own Postgres: postgres://offscreen:…@127.0.0.1:4150/offscreen?sslmode=disable
# Leave unset to use data/db.json instead.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/offscreen

# Sign-in code emails. Gmail needs a 16-letter app password (https://myaccount.google.com/apppasswords),
# not your normal password, written without spaces. The @ in the address is written %40.
SMTP_URL=smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
MAIL_FROM=Offscreen <you@gmail.com>

# Wallpaper images on Cloudflare R2 (see the README). IMAGES_URL is the public bucket's address;
# the R2 API token (Cloudflare dashboard → R2 → Manage API tokens) signs Download links and is
# used by `npm run upload-images`.
IMAGES_URL=https://images.offscreen.wtf
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# "Continue with Google" (optional; the button only shows when both are set).
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application), with
# https://www.offscreen.wtf/api/auth/google/callback (and http://localhost:3001/... for local) as redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostHog analytics (optional; off when unset). The project API key, starting phc_, from
# PostHog → Project settings. It's public (it ends up in the browser), but is read at build time,
# so set it wherever the site is built too.
NEXT_PUBLIC_POSTHOG_KEY=

# Signs the login cookie. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Production only. The API server's address, which the pages and the browser call
# (https://api.offscreen.wtf); read at build time, so set it where the pages are built. Unset, the
# API is this same site, as in local development.
NEXT_PUBLIC_API_URL=

# On the API server: the site's address, the only origin allowed to call the API (read at build
# time, for the CORS headers), and where "Continue with Google" returns to.
SITE_ORIGIN=

# On the API server: the folder holding the original files (the offscreen-originals keys), handed
# out for Downloads instead of signed R2 links.
ORIGINALS_DIR=

# Local development only: read live like/download counts from this API (e.g. https://api.offscreen.wtf)
# without a database or pointing the whole site at the API.
COUNTS_API_URL=
